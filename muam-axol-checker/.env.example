# 三菱UFJアセットマネジメント AXOL マイページログイン情報
AXOL_ID=xxxxxxxx
AXOL_PASSWORD=yyyyyyyyyy

# Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# 通常は変更不要
AXOL_LOGIN_URL=https://axol.jp/zw/s/am_mufg_28/mypage/login
AXOL_BASE_URL=https://axol.jp/zw/s/am_mufg_28/mypage/
TARGET_EVENT_TITLE=【オンライン】5daysサマーインターン
TOP_PATH=top
FORM_LIST_PATH=form
ONLINE_SELECT_PATH=form/2/select
ONSITE_SELECT_PATH=form/1/select
ONLINE_EVENT_TITLE=【オンライン】5daysサマーインターン　8/24(月)～8/28(金)
ONSITE_EVENT_TITLE=【対面】5daysサマーインターン　8/24(月)～8/28(金)
ONLINE_BUTTON_SELECTOR=button#button2
ONSITE_BUTTON_SELECTOR=button#button1

# ログイン直後にセッション/メニュー安定化のため待つ時間（ms）
AFTER_LOGIN_WAIT_MS=5000

# /form や form/2/select / form/1/select の直接遷移を何回リトライするか
NAVIGATION_RETRIES=2

# 初回テスト時は false 推奨。運用時は true 推奨。
HEADLESS=true

# チェック間隔。launchd + pmset の次回wake予約に使用。
CHECK_INTERVAL_MINUTES=15

# true にするとチェック完了後に Mac を再スリープします。初回テストでは false 推奨。
AUTO_SLEEP=false

# true にすると screenshot/html を logs/debug に保存します。
SAVE_DEBUG=true

# Discord通知デバッグ用。
# true にすると、満席でも、枠が0件でも、実行ごとに必ずDiscordへデバッグ通知します。
# 通常運用では false に戻してください。
ALWAYS_NOTIFY_DISCORD=false
