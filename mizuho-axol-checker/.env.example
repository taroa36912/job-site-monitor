# みずほフィナンシャルグループ AXOL マイページのログイン情報
AXOL_ID=xxxxxxxx
AXOL_PASSWORD=yyyyyyyyyy

# Discord Webhook URL（npm run inspect だけなら空でも可）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# Slack Incoming Webhook URL（任意）。Discord と両方設定すると両方へ通知します。
# GitHub Actions で動かす場合は GITHUB_ACTIONS_SETUP.md を参照（Secrets の SLACK_WEBHOOK_URL を使います）。
SLACK_WEBHOOK_URL=

# 通常は変更不要
AXOL_LOGIN_URL=https://axol.jp/zw/s/mizuho-fg_28/mypage/login
AXOL_BASE_URL=https://axol.jp/zw/s/mizuho-fg_28/mypage/
TOP_PATH=top
FORM_LIST_PATH=form
# /form へ直接遷移できない場合に、トップの左メニューから探すリンク文言（カンマ区切り）
FORM_LIST_MENU_TEXTS=予約・確認フォーム

# 監視対象。予約・確認フォームの項目名にこの文字列を含むものを確認します（カンマ区切り）。
# 動作確認時は、現在予約できる別イベントの名前の一部を指定すると通知まで試せます。
TARGET_KEYWORDS=クオンツ,アクチュアリー

# ログイン直後にセッション/メニュー安定化のため待つ時間（ms）
AFTER_LOGIN_WAIT_MS=5000

# /form の直接遷移を何回リトライするか
NAVIGATION_RETRIES=2

# 初回テスト時は false 推奨。運用時は true 推奨。
HEADLESS=true

# チェック間隔。launchd + pmset の次回wake予約に使用。
CHECK_INTERVAL_MINUTES=15

# true にするとチェック完了後に Mac を再スリープします。初回テストでは false 推奨。
AUTO_SLEEP=false

# true にすると screenshot/html を logs/debug に保存します。
SAVE_DEBUG=true

# Discord通知デバッグ用。true にすると予約可否に関係なく毎回Discordへ結果を通知します。
ALWAYS_NOTIFY_DISCORD=false
