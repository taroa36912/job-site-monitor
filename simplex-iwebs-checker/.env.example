# シンプレクス マイページ（i-webs）のログイン情報
IWEBS_ID=S28xxxxxx
IWEBS_PASSWORD=yyyyyyyyyy

# Discord Webhook URL（npm run inspect だけなら空でも可）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# Slack Incoming Webhook URL（任意）。Discord と両方設定すると両方へ通知します。
# GitHub Actions で動かす場合は GITHUB_ACTIONS_SETUP.md を参照（Secrets の SLACK_WEBHOOK_URL を使います）。
SLACK_WEBHOOK_URL=

# 通常は変更不要
IWEBS_BASE_URL=https://mypage.3030.i-webs.jp/simplex2028/

# 監視対象。マイページトップの項目の見出しにこの文字列を含むものを確認します（カンマ区切り）。
# 動作確認時は、現在予約できるイベントの見出しの一部（例: CEO特別セミナー）を指定すると通知まで試せます。
TARGET_TEXTS=人事面談

# 自動予約。人事面談に空き枠が出たら、一番最後（開催日時が最も遅い）の日程を予約し、結果をDiscordに通知します。
AUTO_RESERVE=true
AUTO_RESERVE_TEXTS=人事面談
# true にすると確認画面まで進み、「予約申し込み」は押さずに終了します（動作確認用）。
AUTO_RESERVE_DRY_RUN=false

# ログイン直後に待つ時間（ms）
AFTER_LOGIN_WAIT_MS=2000

# 初回テスト時は false 推奨。運用時は true 推奨。
HEADLESS=true

# チェック間隔。launchd + pmset の次回wake予約に使用。
CHECK_INTERVAL_MINUTES=15

# true にするとチェック完了後に Mac を再スリープします。初回テストでは false 推奨。
AUTO_SLEEP=false

# true にすると screenshot/html を logs/debug に保存します。
SAVE_DEBUG=true

# Discord通知デバッグ用。true にすると予約可否に関係なく毎回Discordへ結果を通知します。
ALWAYS_NOTIFY_DISCORD=false
