<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.local.metlife-axol-checker</string>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>ProgramArguments</key>
    <array>
      <string>__NODE_PATH__</string>
      <string>__PROJECT_DIR__/src/check.js</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/metlife-axol-checker.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/metlife-axol-checker.err.log</string>
  </dict>
</plist>
